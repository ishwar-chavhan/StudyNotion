# ───────────────────────────────────────────────────────
# StudyNotion Backend – Environment Variables
# Copy this file to .env and fill in your own values.
# NEVER commit the real .env file.
# ───────────────────────────────────────────────────────

# Server
PORT=4000

# MongoDB
MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/StudyNotionDb

# JWT
JWT_SECRET=<replace-with-a-long-random-secret>

# Email (SMTP / Gmail)
MAIL_HOST=smtp.gmail.com
MAIL_USER=your-email@gmail.com
MAIL_PASS=your-app-specific-password

# Cloudinary
CLOUD_NAME=<your-cloud-name>
API_KEY=<your-api-key>
API_SECRET=<your-api-secret>
FOLDER_NAME=StudyNotion

# Razorpay
RAZORPAY_KEY=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_SECRET=<your-razorpay-secret>

# CORS – comma-separated list of allowed origins
# On Render, set this to your Vercel production URL
CORS_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# Frontend URL – used to build the password-reset link in emails
# On Render, set this to your Vercel production URL
FRONTEND_URL=http://localhost:3000
